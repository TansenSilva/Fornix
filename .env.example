# -----------------------------------------------------------------------------
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local.
# -----------------------------------------------------------------------------

# Supabase → Project Settings → API (ou Connect)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública ("publishable" sb_publishable_... ou a antiga "anon").
# É segura no navegador porque o acesso aos dados é protegido por RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Chave de criptografia das senhas dos portais (32 bytes em base64).
# Gere com:  openssl rand -base64 32
#       ou:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SOMENTE servidor (sem NEXT_PUBLIC_). Guarde um backup seguro: se perder esta
# chave, as senhas salvas não poderão mais ser lidas.
CREDENTIALS_ENCRYPTION_KEY=
